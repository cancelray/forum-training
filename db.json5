{posts:[{id:'post-1',postAuthor:'User123',postDate:'15.03.2026, 14:20:12',postContent:'Hello! This is the first message on the forum.'},{id:'post-2',postAuthor:'Nick',postDate:'15.03.2026, 14:24:51',postContent:'Hello! Welcome!'},{id:'post-3',postAuthor:'June',postDate:'15.03.2026, 15:01:38',postContent:'Hello! Nice to see you.'},{id:'post-4',postAuthor:'Alex',postDate:'15.03.2026, 09:12:45',postContent:'Hello everyone! Just joined this forum, excited to be here.'},{id:'post-5',postAuthor:'Maria',postDate:'15.03.2026, 10:05:18',postContent:'Welcome Alex! This is a great place to learn and share ideas.'},{id:'post-6',postAuthor:'JohnDoe',postDate:'15.03.2026, 11:47:03',postContent:'Does anyone have good resources for learning React from scratch?'},{id:'post-7',postAuthor:'DevGuy',postDate:'15.03.2026, 12:30:59',postContent:'I recommend starting with official docs and then building small projects.'},{id:'post-8',postAuthor:'Anna',postDate:'15.03.2026, 13:15:22',postContent:'Totally agree, practice is the best way to improve your skills.'},{id:'post-9',postAuthor:'Mike',postDate:'15.03.2026, 14:02:11',postContent:'Has anyone tried using custom hooks extensively in their projects?'},{id:'post-10',postAuthor:'Sophie',postDate:'15.03.2026, 15:44:37',postContent:'Yes! They really help keep the code clean and reusable.'},{id:'post-11',postAuthor:'Chris',postDate:'15.03.2026, 16:20:08',postContent:'What do you think about using Context vs props for state management?'},{id:'post-12',postAuthor:'Nina',postDate:'15.03.2026, 17:05:49',postContent:'Context is great, but I try not to overuse it unless necessary.'},{id:'post-13',postAuthor:'Leo',postDate:'15.03.2026, 18:33:27',postContent:'Thanks everyone for the insights! This discussion is really helpful.'},{id:'post-14',postAuthor:'Jack',postDate:'15.03.2026, 18:43:46',postContent:'Excellent!'},{id:'post-15',postAuthor:'JohnDoe',postDate:'15.03.2026, 19:01:15',postContent:'Thanks everyone!'},{id:'WADBq6GYOGE',postAuthor:'Name',postDate:'04.04.2026, 16:20:57',postContent:'Hi! '},{id:'WGTS9nIotSg',postAuthor:'Leo',postDate:'04.04.2026, 16:21:21',postContent:'Name, hello!'},{id:'LHfUfs8cFqY',postAuthor:'Old',postDate:'04.04.2026, 16:34:00',postContent:'Hello to all newcomers'}],$schema:'./node_modules/json-server/schema.json'}